#include <iostream>
#include <string>
#include <vector>
using namespace std;
#include "trip.h"
trip::trip(string t_d, bus& t_b, route& t_r,string t_t) : trip_date(t_d), trip_bus(t_b), trip_route(t_r),trip_time(t_t)
{
}
trip::~trip()
{
}
// setter and getter for id
void trip::settrip_id(long long t_i)
{
    trip_id = t_i;
}
long long trip ::gettrip_id()
{
    return trip_id;
}
// setter and getter to time
void trip::settrip_time(string t_t)
{
    trip_time = t_t;
}
string trip::gettrip_time()
{
    return trip_time;
}

// setter and getter for date
void trip::settrip_date(string t_d)
{
    trip_date = t_d;
}
string trip ::gettrip_date()
{
    return trip_date;
}
// setter and getter for bus
void trip::settrip_bus(bus& t_b)
{
    trip_bus = t_b;
}
bus trip ::gettrip_bus()
{
    return trip_bus;
}
// setter and getter for route
void trip::settrip_route(route& t_r)
{
    trip_route = t_r;
}
route trip ::gettrip_route()
{
    return trip_route;
}